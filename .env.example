# Collection URL (on-prem TFS / Azure DevOps Server). Include the collection segment.
TFS_BASE_URL=https://tfs.corp.local/tfs/DefaultCollection

# Personal access token. Needs at least: Work Items (read, write), Code (read), Identity (read).
TFS_PAT=

# Optional: project used when a tool call does not pass `project`.
TFS_DEFAULT_PROJECT=

# Optional: REST API version (default 6.0). Comments/identity endpoints use their own preview versions internally.
# TFS_API_VERSION=6.0

# Optional: max parallel requests for fan-out batch tools (default 5).
# TFS_BATCH_CONCURRENCY=5

# Optional: accept self-signed certificates (sets NODE_TLS_REJECT_UNAUTHORIZED=0).
# TFS_INSECURE_TLS=false
